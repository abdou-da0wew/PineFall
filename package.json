{
  "name": "pinefall-night-courier",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts cpu",
    "test:webgl": "bun scripts/run-tests.ts webgl",
    "test:webgpu": "bun scripts/run-tests.ts webgpu",
    "test:vgpu-node": "bun test-vgpu-node.ts",
    "check:shader": "bun --bun vgpu check src/vgpu/world.wgsl --require-validation"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vgpu/wgsl": "0.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
